{
  "manifest_version": 3,
  "name": "Instagram Reels Counter & Blocker",
  "version": "2.0",
  "description": "Counts Reels watched and blocks access after 50 reels daily",
  "permissions": ["storage", "notifications", "activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}